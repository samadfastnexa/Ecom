# Backend API Configuration
# Copy this file to .env.
#
# By default (see app.config.js) the app uses the live deployed backend, so
# you don't need to set anything for production.

# ── Option A: full API URL (live or any custom backend) ──────────────────
# Takes priority over API_HOST/API_PORT.
API_URL=https://century.zipnixtechnologies.com/api

# ── Option B: local dev against a backend on your LAN ────────────────────
# Comment out API_URL above and set these instead.
# Find your IP: Windows `ipconfig` (IPv4 Address), Mac/Linux `ifconfig`/`ip addr`.
# API_HOST=YOUR_LOCAL_IP
# API_PORT=8002

# ── Google Sign-In ───────────────────────────────────────────────────────────
# OAuth client IDs from Google Cloud Console → APIs & Services → Credentials,
# in the existing project `ecom-c08aa` (same project as google-services.json).
# Public identifiers, not secrets. Leave blank to hide the Google buttons.
#
# Required on every platform — Expo uses it as the base client ID:
GOOGLE_WEB_CLIENT_ID=
# Android client: package com.centurysip.store + SHA-1 from `eas credentials`
GOOGLE_ANDROID_CLIENT_ID=
# iOS client: bundle id com.centurysip.store
GOOGLE_IOS_CLIENT_ID=
#
# The backend must allow these same IDs — set GOOGLE_ALLOWED_CLIENT_IDS in
# backend/.env to the comma-separated list, or every token is rejected.
