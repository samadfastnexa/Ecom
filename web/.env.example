# ── Web (Next.js admin + storefront) environment ──────────────────────────────
# These are PUBLIC values baked into the browser bundle — never put secrets here.
#
# Used when USE_LOCAL = false in src/lib/constants.ts (production/live).
# For local development you can instead set USE_LOCAL = true in that file, which
# points the app at http://localhost:8002 without needing these vars.

# Backend API base URL (must end with /api)
NEXT_PUBLIC_API_URL=https://century.zipnixtechnologies.com/api

# Base URL where uploaded media (product/complaint images) is served from
NEXT_PUBLIC_MEDIA_URL=https://century.zipnixtechnologies.com

# Google OAuth "Web application" client ID (Google Cloud Console → Credentials).
# Leave empty to hide the "Continue with Google" buttons entirely.
# The site origin must be listed under that client's Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Maps JavaScript API browser key, for the live rider map under
# /manage/riders → Live Map. Leave empty to fall back to the rider list with a
# "Map key not configured" notice — nothing else on the page is affected.
# This key ships inside the public bundle, so restrict it in Google Cloud
# Console by HTTP referrer (the admin origin) and to the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
