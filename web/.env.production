# Production build config for the static export (admin.zipnixtechnologies.com).
# These are baked into the build at `next build` time.
NEXT_PUBLIC_API_URL=https://century.zipnixtechnologies.com/api
NEXT_PUBLIC_MEDIA_URL=https://century.zipnixtechnologies.com

# Google sign-in. Add https://admin.zipnixtechnologies.com to the client's
# "Authorized JavaScript origins" before deploying.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1054797578232-k9t48k0dp7sl5fpc8oo6tjktps4r86og.apps.googleusercontent.com

# Live rider map. Restrict the key to https://admin.zipnixtechnologies.com/*
# and to the Maps JavaScript API before filling it in — it is readable by
# anyone who loads the admin panel. Empty = the map is replaced by the rider
# list, which is the correct state until a key exists.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
